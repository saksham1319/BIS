# ─────────────────────────────────────────────────────────────
#  BIS Saathi — environment
#  Copy this file to `.env.local` and fill in the values.
#      cp .env.example .env.local
# ─────────────────────────────────────────────────────────────

# REQUIRED — Google Gemini API key (model: gemini-2.5-flash)
# Get a free key at https://aistudio.google.com/apikey
# Server-side only. Never prefix this with NEXT_PUBLIC_.
GEMINI_API_KEY=

# OPTIONAL — Supabase auth. Auth is disabled for the demo; the app
# runs fully without these. Fill them in only if you enable sign-in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
